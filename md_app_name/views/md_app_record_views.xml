<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="md_app_record_view_list" model="ir.ui.view">
        <field name="name">md.app.record.view.list</field>
        <field name="model">md.app.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="md_code"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="md_app_record_view_form" model="ir.ui.view">
        <field name="name">md.app.record.view.form</field>
        <field name="model">md.app.record</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name"/>
                            <field name="md_code"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Status">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="md_note" colspan="2"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="md_app_record_view_search" model="ir.ui.view">
        <field name="name">md.app.record.view.search</field>
        <field name="model">md.app.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="md_code"/>
                <filter
                    name="md_filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group string="Group By">
                    <filter
                        name="md_group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="md_app_record_action" model="ir.actions.act_window">
        <field name="name">App Records</field>
        <field name="res_model">md.app.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
